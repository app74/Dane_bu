DATABASE_URL=sqlite:///./backend/app.db
# Iba pre hostované nasadenie (Vercel) – skutočné hodnoty nastavte vo Vercel Environment Variables, nie sem.
# APP_PASSWORD=
# SESSION_SECRET=
# FS_LOOKUP_ENABLED=false
# Trvalý priečinok cache exportov FS (Azure: /home/data/fs-exports nastaví startup.sh).
# FS_CACHE_DIR=
